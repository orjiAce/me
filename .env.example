# Contact API — §12.1. The site builds and runs with none of these set:
# the form renders, and submissions return 503 email_unavailable with a
# mailto fallback surfaced client-side.

# Resend — the email channel. Without it the form is in degraded mode.
RESEND_API_KEY=
# Where notifications go (defaults to profile.email) and the from address.
# BOTH must be on the Resend-verified sending domain (v5 §3). A from
# address on gmail.com — or any domain Resend has not verified — fails at
# send time with no client-visible signal, so the route logs a loud
# warning at startup when the domain does not match the canonical site
# domain. Defaults to onboarding@resend.dev when unset.
CONTACT_TO_EMAIL=hello@orji.dev
CONTACT_FROM_EMAIL=hello@orji.dev

# Cloudflare Turnstile — bot check. Without keys the check is skipped and
# logged; honeypot + timing + rate limiting still apply (§17 row 15).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Signs the form's timing challenge. Without it an ephemeral per-deploy
# secret is generated (logged as degradation). Any long random string.
FORM_SECRET=

# Upstash Redis — durable rate limiting. Without it an in-memory LRU is
# used (resets on deploy), with a logged warning (§12.1.3).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Plausible analytics domain (M9) — public by design.
# Canonical origin: defaults to https://orji.dev in lib/site.ts; override for previews.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
