# ============================================================
# The site MUST build and run with every key below empty (§19).
# Missing keys degrade features; they never break the build.
# Copy to .env.local and fill in what you have.
# ============================================================

# --- Contact form (§12.1) — without these the form shows the mailto fallback
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret used to HMAC-sign the form-mount timestamp (bot timing check)
FORM_SECRET=

# --- Rate limiting (§12.1) — falls back to in-memory LRU when absent
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Zowis product feed (§12.2, optional) — anon key ONLY, never service role
ZOWIS_SUPABASE_URL=
ZOWIS_SUPABASE_ANON_KEY=

# --- Analytics (§12.6) — Plausible, no cookies
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- On-demand revalidation (§8, optional, secret-guarded)
REVALIDATE_SECRET=
